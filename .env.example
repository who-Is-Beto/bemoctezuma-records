# Copy to .env.local (local dev) or set in Railway (prod). Never commit real values.

# ── Email ────────────────────────────────────────────────────────────────
# Used by every transactional email, including the owner notifications sent
# when a sale is registered in Gestionar Discos (Vender).
# Prod sends through Resend's HTTP API (Railway blocks outbound SMTP).
# With neither RESEND_API_KEY nor EMAIL_BACKEND set, emails print to the console.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@moctezumarecords.com

# Optional: plain SMTP instead of Resend (e.g. local testing with Gmail).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10

# ── Ventas metrics ───────────────────────────────────────────────────────
# Estimated Stripe fee per online order: (amount × PERCENT% + FIXED) × (1 + VAT%).
# Optional; defaults are Stripe México standard pricing.
# STRIPE_FEE_PERCENT=3.6
# STRIPE_FEE_FIXED=3.00
# STRIPE_FEE_VAT=16
